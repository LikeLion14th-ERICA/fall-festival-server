* text=auto eol=lf

# Cross-platform source and deployment files
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf

