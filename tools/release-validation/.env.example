# Copy this file only to a protected location. Do not fill in secrets or actual
# host values here, commit the copy, or upload it with release evidence.
RELEASE_ENVIRONMENT=staging
RELEASE_IMAGE=<registry/image@sha256:64-lowercase-hex>
RELEASE_COMMIT=<40-lowercase-hex-commit>

# Runtime values below are provided by the protected staging secret store.
# SPRING_PROFILES_ACTIVE=db
# SPRING_DATASOURCE_URL=<protected>
# SPRING_DATASOURCE_USERNAME=<protected>
# SPRING_DATASOURCE_PASSWORD=<protected>
# ADMIN_JWT_SIGNING_SECRET=<protected>
# ADMIN_ALLOWED_ORIGIN=<protected-staging-origin>
# FESTIVAL_ID=<approved-staging-festival-uuid>

# The runtime template rejects any other values for these safety controls.
SPRING_FLYWAY_ENABLED=false
FESTIVAL_CLEANUP_SCHEDULE_ENABLED=false
FESTIVAL_CLEANUP_DRY_RUN=true
