# Public hostname only: no scheme, port, path, or trailing slash.
APP_DOMAIN=

# Required only by docker-compose.e2-micro.yml. Build application images on
# another machine and pin every linux/amd64 runtime image by registry digest.
BACKEND_IMAGE=
FRONTEND_IMAGE=
POSTGRES_IMAGE=
CADDY_IMAGE=

# Must exactly match the public origin used by the browser.
APP_ALLOWED_ORIGINS=

# Blank values below are intentional: fill every required value before startup.
POSTGRES_DB=espero_push
POSTGRES_USER=espero_push
POSTGRES_PASSWORD=

# Shared gate used only when issuing a new anonymous test session.
# It is not a user identity and must not be reused as an admin password.
TEST_ACCESS_CODE=

# Minimum 32-byte high-entropy secret used to HMAC session/ACK tokens.
# Keep it stable across deployments; rotating it invalidates sessions/unacknowledged ACKs.
APP_TOKEN_PEPPER=

# Generate one VAPID key pair once. Keep the private key secret and stable.
APP_VAPID_PUBLIC_KEY=
APP_VAPID_PRIVATE_KEY=
APP_VAPID_SUBJECT=

# Application defaults
APP_SESSION_TTL=P7D
APP_SESSION_CLEANUP_DELAY=PT1H
APP_PUSH_ENABLED=true
APP_CLOCK_ZONE=Asia/Seoul
APP_COOKIE_SECURE=true

# Comma-separated suffix allowlist used to reject arbitrary push endpoints.
# Targets Chromium/FCM, Apple, Firefox/Mozilla, and Microsoft Edge/WNS.
APP_PUSH_ALLOWED_ENDPOINT_HOST_SUFFIXES=fcm.googleapis.com,jmt17.google.com,.push.apple.com,.push.services.mozilla.com,.notify.windows.com

# Optional operational tuning. ISO-8601 durations are used by Spring Boot.
APP_ACCESS_MAX_FAILURES=5
APP_ACCESS_FAILURE_WINDOW=PT15M
APP_ACK_MAX_REQUESTS=60
APP_ACK_RATE_WINDOW=PT1M
APP_PUSH_TTL=PT70S
APP_PUSH_MAX_ATTEMPTS=3
APP_PUSH_REQUEST_TIMEOUT=PT15S
APP_PUSH_WORKER_DELAY=PT5S
APP_CLOCK_SCHEDULER_DELAY=PT5S
APP_SCHEDULER_POOL_SIZE=2
SPRING_DATASOURCE_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_MINIMUM_IDLE=1
