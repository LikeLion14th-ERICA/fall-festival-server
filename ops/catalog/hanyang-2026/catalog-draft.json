  "artistTranslations": [
    {
      "artistId": "nct-wish",
      "locale": "ko",
      "name": "NCT WISH",
      "imageAlt": "NCT WISH 프로필 사진",
      "introduction": "🌠NCT WISH🌠\n💫 눈부시게 맑은, 우리를 닮은 소년의 계절 💫\n이 가을 우리 모두의 소원(WISH)이 되어줄 NCT WISH"
    },
    {
      "artistId": "nowimyoung",
      "locale": "ko",
      "name": "나우아임영",
      "imageAlt": "나우아임영 프로필 사진",
      "introduction": "💋나우아임영💋\n🔥 한 마디면 떼창, 두 마디면 전부 뛰게 만드는 화력 🔥\n'KISS KISS KISS'로 ERICA의 심장을 훔치러 오는 나우아임영"
    },
    {
      "artistId": "kim-haon",
      "locale": "ko",
      "name": "김하온",
      "imageAlt": "김하온 프로필 사진",
      "introduction": "🎶김하온🎶\n💨 힘을 뺀 목소리로 더 깊게 박히는 사색의 라임 💨\n'붕붕' 타고 동심의 하늘 위를 날아오를 김하온"
    },
    {
      "artistId": "lucenne",
      "locale": "ko",
      "name": "리센느",
      "imageAlt": "리센느 프로필 사진",
      "introduction": "💗리센느💗\n⭐ 별처럼 반짝이는 다섯 소녀의 청량한 한 컷 ⭐\n'Pretty Girl'로 캠퍼스를 온통 핑크빛으로 물들일 리센느"
    },
    {
      "artistId": "heegyu",
      "locale": "ko",
      "name": "희규",
      "imageAlt": "희규 프로필 사진",
      "introduction": "🌙희규🌙\n🎸 듣기만 해도 스며드는 위로, 담백한 목소리 위 밴드 사운드 🎸\n'고장난 히치하이킹'으로 가을밤을 통째로 옮겨다 놓을 희규"
    },
    {
      "artistId": "ahof",
      "locale": "ko",
      "name": "아홉 (AHOF)",
      "imageAlt": "아홉 (AHOF) 프로필 사진",
      "introduction": "⚡아홉⚡\n🏆 아홉 명이 완성하는 단 하나의 무대 🏆\n명예의 전당을 향해 거침없이 달려가는 아홉(AHOF)"
    },
    {
      "artistId": "alphadriveone",
      "locale": "ko",
      "name": "알파드라이브원",
      "imageAlt": "알파드라이브원 프로필 사진",
      "introduction": "🚀알파드라이브원🚀\n🔥 멈추지 않는 질주 🔥\n캠퍼스를 통째로 뒤흔들 알파드라이브원"
    },
    {
      "artistId": "fromis-9",
      "locale": "ko",
      "name": "프로미스나인",
      "imageAlt": "프로미스나인 프로필 사진",
      "introduction": "🍊프로미스나인🍊\n✨ 상큼한 에너지로 한양문화제의 무대를 환하게 물들이는 순간,\n한양을 더 설레게 할 프로미스나인(fromis_9)이 찾아옵니다! 🍀\n* 지원 불참"
    }
  ],
