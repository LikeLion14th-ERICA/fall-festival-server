# Reference only: Spring Boot does not automatically load this file.
# Set these variables in the shell or IDE run configuration.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# PostgreSQL connection. Convert shared postgres://user:password@host:port/db
# URIs into these three separate values; do not paste the combined URI here.
# These only take effect when SPRING_PROFILES_ACTIVE=db (see below); without
# that profile the app starts with no DataSource at all.
SPRING_PROFILES_ACTIVE=db
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:25565/DB_NAME
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Defaults to true in the db profile now that migrations exist under
# src/main/resources/db/migration. Set to false to skip applying them.
SPRING_FLYWAY_ENABLED=true

# Stable UUID of the Festival served by this application instance. Required
# with the db profile; the server never guesses the current Festival from DB rows.
FESTIVAL_ID=

# Administrator authentication. Set one explicit HTTP(S) admin frontend origin;
# wildcard origins are rejected because refresh requests include credentials.
# Generate a unique JWT signing secret with:
# openssl rand -base64 32
ADMIN_JWT_SIGNING_SECRET=
ADMIN_ALLOWED_ORIGIN=

# Public API and operational safety settings.
# Keep the hash only; never put the six-digit stamp code or its hash itself in a commit.
STAMP_RECEIPT_CODE_SHA256=
# Set to false only when an approved deployment intentionally disables limits.
RATE_LIMIT_ENABLED=true
# Number of trusted proxies that append X-Forwarded-For (0 when none).
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Log failed and slow API requests with safe route patterns and request IDs.
# Success logging stays enabled for release-equivalent tests and normal operation.
FESTIVAL_HTTP_SLOW_REQUEST_MS=500
FESTIVAL_HTTP_LOG_SUCCESS=true
# Set to the deployed commit SHA to identify the binary in structured logs.
RELEASE_COMMIT=unknown
# Korean is always public; add only locales with complete approved catalog content.
PUBLIC_LOCALES=ko

# Writable root for goods image originals and generated variants.
# Docker deployments commonly mount /var/lib/espero/media here. Omit this variable when
# goods images are unused; an explicitly blank value fails startup.
FESTIVAL_MEDIA_STORAGE_ROOT=

# Comma-separated exact HTTPS hostnames allowed for outbound transfer links.
# Leave empty until an approved destination exists; use hosts only, never URLs.
ACCOUNT_TRANSFER_LINK_ALLOWED_HOSTS=

# Swagger UI at /docs for local and development servers only. Keep false in production.
API_DOCS_ENABLED=false

# Optional one-time bootstrap. Both values must be present and are used only
# when admin_accounts is empty. The password needs at least 15 Unicode code points
# and at most 72 UTF-8 bytes. Do not commit real credentials. After confirming the
# first administrator was created, remove both variables from the runtime environment.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
